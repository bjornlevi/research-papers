.venv/
__pycache__/
*.pyc

# Licensed sources, extracted full text, rendered pages, and local provenance.
/papers/**
!/papers/supplements/
/papers/supplements/**
!/papers/supplements/README.md
/evidence/**
!/evidence/README.md
!/evidence/knowledge/
/evidence/knowledge/**
!/evidence/knowledge/README.md

# Local credentials, runtime state, and deployment data.
.env
.env.*
!.env.example
.mcp.json
/releases/
/docs/titles/
/docs/titles-comparison.csv
/dist/
/build/
*.egg-info/

# Machine-local make settings (e.g. LAN_HOST).
/local.mk
/node_modules/

# Only current per-paper state belongs in Git; runtime data remains local.
/.paper-state.writer.lock
/paper-state/*
!/paper-state/manifest.json
!/paper-state/papers/
/paper-state/papers/*
!/paper-state/papers/*.json
/paper-state/papers/.*
